; Snake Background Loop - A steady, tense pattern
tempo 140
duration 8

loop 4
  note G4 8
  rest 8
  note F#4 8
  rest 8
endloop

loop 4
  note E4 8
  rest 8
  note F#4 8
  rest 8
endloop

loop 2
  note G4 8
  rest 8
  note A4 8
  rest 8
endloop

loop 2
  note B4 8
  rest 8
  note C5 8
  rest 8
endloop

; Repeat from the start (but we don't have a "goto", so just loop the whole file)
; In your player, you'd call this in a loop.